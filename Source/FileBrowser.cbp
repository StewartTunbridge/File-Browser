<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="FileBrowser" />
		<Option makefile="makefile" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/FileBrowser" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option host_application="FileBrowser/bin/Debug" />
				<Option run_host_application_in_terminal="0" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DDEBUG" />
				</Compiler>
				<Linker>
					<Add library="X11" />
					<Add library="xkbcommon" />
					<Add library="asound" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/FileBrowser" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-Os" />
					<Add option="-DRELEASE" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="X11" />
					<Add library="xkbcommon" />
					<Add library="asound" />
				</Linker>
			</Target>
			<Target title="ReleaseWin">
				<Option output="bin/Release/FileBrowser" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-D_Windows" />
					<Add option="-DRELEASE" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-static" />
					<Add library="C:/Windows/System32/ws2_32.dll" />
					<Add library="C:/Windows/System32/gdi32.dll" />
					<Add library="C:/Windows/System32/winmm.dll" />
				</Linker>
			</Target>
			<Target title="ReleaseSDL">
				<Option output="bin/Release/FileBrowserSDL" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DRELEASE" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="SDL2" />
					<Add library="SDL2_mixer" />
				</Linker>
			</Target>
			<Target title="DebugWin">
				<Option output="bin/Release/FileBrowser" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option use_console_runner="0" />
				<Compiler>
					<Add option="-g" />
					<Add option="-D_Windows" />
					<Add option="-DRELEASE" />
				</Compiler>
				<Linker>
					<Add library="C:/Windows/System32/ws2_32.dll" />
					<Add library="C:/Windows/System32/gdi32.dll" />
					<Add library="C:/Windows/System32/winmm.dll" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-DLOGSIMPLE" />
		</Compiler>
		<Unit filename="../Widgets/ColourSelect.cpp" />
		<Unit filename="../Widgets/FileSelect.cpp" />
		<Unit filename="../Widgets/MessageBox.cpp" />
		<Unit filename="../Widgets/MessageResponseBox.cpp" />
		<Unit filename="../Widgets/Widgets.cpp" />
		<Unit filename="../Widgets/WidgetsDriverSDL.cpp">
			<Option target="ReleaseSDL" />
		</Unit>
		<Unit filename="../Widgets/WidgetsDriverWin.cpp">
			<Option target="ReleaseWin" />
			<Option target="DebugWin" />
		</Unit>
		<Unit filename="../Widgets/WidgetsDriverX.cpp">
			<Option target="Debug" />
			<Option target="Release" />
		</Unit>
		<Unit filename="../Widgets/WidgetsEdit.cpp" />
		<Unit filename="../Widgets/WidgetsGrid.cpp" />
		<Unit filename="../Widgets/WidgetsImageBMP.cpp" />
		<Unit filename="../Widgets/WidgetsTextSTB.cpp" />
		<Unit filename="../Widgets/WidgetsTree.cpp" />
		<Unit filename="../Widgets/lib.cpp" />
